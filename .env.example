# RingGuard contains no secrets and requires no external AI credentials.
RINGGUARD_SEED=42
RINGGUARD_DATA_DIR=data
RINGGUARD_DB_PATH=data/ringguard.db
RINGGUARD_LOG_LEVEL=INFO
RINGGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Frontend build-time API origin. Local Vite default is http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000
